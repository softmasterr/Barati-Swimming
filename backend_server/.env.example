# ====================================================================
# پیکربندی سرور ابری آکادمی شنا براتی (Barati Swimming Academy Cloud)
# ====================================================================

# محیط اجرا (development / production / test)
NODE_ENV=production

# پورت سرور
PORT=3000

# مسیر فایل دیتابیس لوکال SQLite
DATABASE_PATH=data/barati.db

# --------------------------------------------------------------------
# کلیدهای امنیتی و رمزنگاری داده‌ها (بسیار مهم: غیرقابل تغییر پس از ثبت داده‌ها)
# --------------------------------------------------------------------
# کلید اصلی رمزنگاری سطح فیلد دیتابیس (AES-256-GCM) - حداقل ۳۲ کاراکتر
DATA_ENCRYPTION_KEY=your-super-secret-aes-256-encryption-master-key-change-me!

# سالت رمزنگاری برای مشتق‌سازی کلید با Scrypt
DATA_ENCRYPTION_SALT=barati-swimming-master-salt-production-2026

# کلید امضای توکن‌های نشست مدیریت (JWT Secret)
JWT_SECRET=your-jwt-production-secret-token-key-change-me!

# مدت اعتبار نشست مدیریت
JWT_EXPIRY=24h

# --------------------------------------------------------------------
# دسترسی اولیه مدیر ارشد (در اولین اجرای سرور ساخته می‌شود)
# --------------------------------------------------------------------
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@Barati2026!

# --------------------------------------------------------------------
# سیاست‌های امنیتی و کنترل ترافیک (DDoS & Brute-Force Prevention)
# --------------------------------------------------------------------
# حداکثر تلاش ناموفق ورود پیش از قفل خودکار IP و اکانت (پیش‌فرض: ۵)
LOCKOUT_MAX_ATTEMPTS=5

# مدت زمان قفل شدن IP پس از ۵ بار خطا (به میلی‌ثانیه - پیش‌فرض: ۱۵ دقیقه)
LOCKOUT_DURATION_MS=900000

# سقف کلی درخواست‌ها به ازای هر آی‌پی در بازه ۱۵ دقیقه
RATE_LIMIT_MAX=100

# دامنه‌های مجاز CORS (برای پنل وب)
CORS_ORIGIN=*
